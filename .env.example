# /!\ Ne pas mettre de donnees sensibles dans ce fichier : nginx le sert a tous les visiteurs /!\
# Les commentaires restent sur leur propre ligne : apres une valeur vide, Compose les lirait comme la valeur

# Nom de l'application
APP_NAME=Floraccess
# URL de l'API FlorAccess (en production, elle doit aussi etre dans le connect-src de nginx.conf)
DATA_URL=http://localhost:26001

# /!\ DEV uniquement /!\ Port sur lequel l'application Flutter Web est servie par docker-compose.dev.yml
APP_PORT=26007
